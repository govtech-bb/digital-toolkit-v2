---
layout: layouts/base.njk
isHome: true
pageTitle: "Digital Toolkit – GovTech Barbados"
tagLabels:
  new: New
  soon: Coming soon
  later: Coming later
---
<section class="hero">
  <div class="container">
    <h1>{{ heroTitle }}</h1>
    {% if lastUpdated %}<p class="hero__subtitle">Last updated {{ lastUpdated }}</p>{% endif %}
    <hr class="hero__rule">
    <p class="hero__lede">{{ lede | safe }}</p>
  </div>
</section>

<main class="main-content">
  <div class="container">

    {% for section in sections %}
    <section class="toolkit-section">
      <h2 class="toolkit-section__heading">{{ section.heading }}</h2>
      <p class="toolkit-section__desc">{{ section.desc }}</p>
      <ul class="resource-list">
        {% for item in section.items %}
          {% set entry = collections.all | pageByPath(item.page) %}
          {% set itemTitle = entry.data.title if entry else item.title %}
          {% set itemHref  = entry.url        if entry else item.href %}
          {% if item.emailContact %}{% set itemHref = 'mailto:' + site.email %}{% endif %}
          {% set itemDesc  = entry.data.lede  if entry else item.desc %}
        <li class="resource-item">
          <a class="resource-item__link" href="{{ itemHref }}">{{ itemTitle }}{% if itemHref | isExternal %}<svg class="resource-item__external-icon" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.25" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><line x1="7" y1="17" x2="17" y2="7"/><polyline points="8 7 17 7 17 16"/></svg><span class="visually-hidden"> (external link)</span>{% endif %}</a>
          {% if item.tag %}<span class="tag tag--{{ item.tag }}">{{ tagLabels[item.tag] }}</span>{% endif %}
          <p class="resource-item__desc">{{ itemDesc | safe }}</p>
        </li>
        {% endfor %}
      </ul>
    </section>
    {% endfor %}

    {% if cta %}
    {% set ctaHref = ('mailto:' + site.email) if cta.emailContact else cta.href %}
    <div class="cta-panel">
      <h2>{{ cta.heading }}</h2>
      <p>{{ cta.body | safe }}</p>
      <a class="button" href="{{ ctaHref }}">{{ cta.label }}</a>
    </div>
    {% endif %}

  </div>
</main>
